{
    "manifest_version": 3,
    "name": "Ticker Hop",
    "version": "1.4",

    "description": "Adds TradingView and Yahoo Finance links and price alerts to Nordnet stock pages.",

    "permissions": ["notifications"],
    "background": {
        "scripts": ["src/background.js"]
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "ticker-hop@bobby",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "host_permissions": ["*://*.nordnet.dk/*", "*://*.nordnet.se/*", "*://*.nordnet.no/*", "*://*.nordnet.fi/*"],

    "content_scripts": [
        {
            "matches": ["*://*.nordnet.dk/*", "*://*.nordnet.se/*", "*://*.nordnet.no/*", "*://*.nordnet.fi/*"],
            "js": [
                "src/core/stock.js",
                "src/features/ticker-links/ticker-links.js",
                "src/features/price-alert/price-alert.js",
                "src/core/main.js"
            ],
            "css": ["src/features/ticker-links/ticker-links.css", "src/features/price-alert/price-alert.css"]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["icons/tradingview.svg", "icons/yahoofinance.svg"],
            "matches": ["*://*.nordnet.dk/*", "*://*.nordnet.se/*", "*://*.nordnet.no/*", "*://*.nordnet.fi/*"]
        }
    ]
}
